{
  "name": "c-workflow-tools",
  "displayName": "C Workflow Tools",
  "description": "（个人自用）C/C++ 工程与 Git 工作流定制工具：C 宏块快捷选中、全局符号搜索、Git 任意两节点 difftool 对比、打包两节点间差异文件（修改前/修改后）.",
  "publisher": "cxy",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/525716612/c-workflow-tools"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "macro",
    "c",
    "cpp",
    "c++",
    "git",
    "difftool",
    "diff",
    "package",
    "symbol",
    "search"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2d7d9a",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "c-workflow-tools.selectMacroBlock",
        "title": "C Workflow: 选中当前条件编译块（#if/#elif/#else）",
        "category": "C Workflow"
      },
      {
        "command": "c-workflow-tools.gitDifftoolCompare",
        "title": "C Workflow: Git 对比任意两个节点",
        "category": "C Workflow"
      },
      {
        "command": "c-workflow-tools.packageDiff",
        "title": "C Workflow: 打包两节点间差异文件",
        "category": "C Workflow"
      },
      {
        "command": "c-workflow-tools.diagnoseSymbolSearch",
        "title": "C Workflow: 诊断符号搜索（输出到输出面板）",
        "category": "C Workflow"
      }
    ],
    "keybindings": [
      {
        "command": "c-workflow-tools.gitDifftoolCompare",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "c-workflow-tools.gitDifftoolCompare",
        "key": "cmd+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "c-workflow-tools.packageDiff",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "c-workflow-tools.packageDiff",
        "key": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "c-workflow-tools",
          "title": "C Workflow",
          "icon": "$(git-compare)"
        }
      ]
    },
    "views": {
      "c-workflow-tools": [
        {
          "id": "c-workflow-tools.symbolSearchView",
          "name": "符号搜索",
          "type": "webview",
          "icon": "$(symbol-search)"
        },
        {
          "id": "c-workflow-tools.workflowView",
          "name": "Git 工作流",
          "icon": "$(git-compare)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --allow-missing-repository",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "archiver": "^7.0.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
